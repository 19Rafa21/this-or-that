# Substitui as credenciais de exemplo pelas da tua conta PostgreSQL local.
DATABASE_URL=postgresql://this_or_that:change_me@localhost:5432/this_or_that
DATABASE_SSL=false
PORT=50820
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Opcional: gera o hash da palavra-passe de administração com npm run admin:password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Opcional: segredo aleatório com pelo menos 32 caracteres para exportações por HTTP.
EXPORT_TOKEN=
